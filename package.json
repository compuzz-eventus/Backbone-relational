{
  "name": "backbone-relational",
  "main": "backbone-relational.js",
  "description": "Get and set relations (one-to-one, one-to-many, many-to-one) for Backbone models",
  "homepage": "http://backbonerelational.org",
  "keywords": [
    "backbone",
    "relation",
    "nested",
    "model"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/compuzz-eventus/Backbone-relational.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "author": "Compuzz-Eventus <https://github.com/compuzz-eventus>",
  "contributors": "Listed at <https://github.com/compuzz-eventus/Backbone-relational/contributors>",
  "peerDependencies": {
    "backbone": ">=1.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "version": "0.11.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "backbone": "github:compuzz-eventus/backbone#26271ba9d892d625e70dbb265fa2d9ff11256011",
    "eslint": "10",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jquery": "^4.0.0",
    "lint-staged": "^17.0.4",
    "prettier": "3",
    "semver": "^7.6.3",
    "underscore": "^1.13.8",
    "vitest": "^4.1.6"
  },
  "packageManager": "yarn@4.14.1"
}
